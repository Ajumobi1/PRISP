entrypoint = "frontend/app/task-tracker/page.tsx"
modules = ["nodejs-20", "python-3.12"]
hidden = [".git", ".next", "node_modules", ".venv", ".venv-1"]

run = "bash ./replit-start.sh"

[nix]
channel = "stable-24_05"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
deploymentTarget = "cloudrun"
build = "bash ./replit-build.sh"
run = "bash ./replit-start.sh"

[[ports]]
localPort = 3000
externalPort = 80
